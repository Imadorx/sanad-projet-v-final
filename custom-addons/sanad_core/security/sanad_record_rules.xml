<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- ===================================================== -->
        <!-- sanad.doctor: a doctor may only WRITE their own record. -->
        <!-- Read access stays open to Doctor/Patient/Lab/Pharmacy   -->
        <!-- groups via ir.model.access.csv (needed for selection    -->
        <!-- fields / directories across the app). Admin is          -->
        <!-- unrestricted via a separate global rule.                -->
        <!-- ===================================================== -->

        <record id="rule_sanad_doctor_write_own" model="ir.rule">
            <field name="name">Doctor: write own profile only</field>
            <field name="model_id" ref="model_sanad_doctor"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_sanad_doctor'))]"/>
            <field name="perm_read">0</field>
            <field name="perm_write">1</field>
            <field name="perm_create">0</field>
            <field name="perm_unlink">0</field>
        </record>

        <record id="rule_sanad_doctor_admin_full" model="ir.rule">
            <field name="name">Doctor: admin full access</field>
            <field name="model_id" ref="model_sanad_doctor"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_sanad_admin'))]"/>
            <field name="perm_read">1</field>
            <field name="perm_write">1</field>
            <field name="perm_create">1</field>
            <field name="perm_unlink">1</field>
        </record>

        <!-- ===================================================== -->
        <!-- sanad.ai.log: every non-admin role sees ONLY their own  -->
        <!-- audit rows. Admin sees everything (audit requirement,   -->
        <!-- PRD Section 14.4 / 15.3).                                -->
        <!-- ===================================================== -->

        <record id="rule_sanad_ai_log_own_doctor" model="ir.rule">
            <field name="name">AI Log: doctor sees own requests only</field>
            <field name="model_id" ref="model_sanad_ai_log"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_sanad_doctor'))]"/>
        </record>

        <record id="rule_sanad_ai_log_own_patient" model="ir.rule">
            <field name="name">AI Log: patient sees own requests only</field>
            <field name="model_id" ref="model_sanad_ai_log"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_sanad_patient'))]"/>
        </record>

        <record id="rule_sanad_ai_log_own_laboratory" model="ir.rule">
            <field name="name">AI Log: laboratory user sees own requests only</field>
            <field name="model_id" ref="model_sanad_ai_log"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_sanad_laboratory'))]"/>
        </record>

        <record id="rule_sanad_ai_log_own_pharmacy" model="ir.rule">
            <field name="name">AI Log: pharmacy user sees own requests only</field>
            <field name="model_id" ref="model_sanad_ai_log"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_sanad_pharmacy'))]"/>
        </record>

        <record id="rule_sanad_ai_log_admin_full" model="ir.rule">
            <field name="name">AI Log: admin sees all requests</field>
            <field name="model_id" ref="model_sanad_ai_log"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_sanad_admin'))]"/>
        </record>

    </data>
</odoo>
