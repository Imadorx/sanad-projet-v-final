<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_sanad_medical_specialty_list" model="ir.ui.view">
            <field name="name">sanad.medical.specialty.list</field>
            <field name="model">sanad.medical.specialty</field>
            <field name="arch" type="xml">
                <list string="Medical Specialties">
                    <field name="name"/>
                    <field name="code"/>
                    <field name="active" column_invisible="1"/>
                </list>
            </field>
        </record>

        <record id="view_sanad_medical_specialty_form" model="ir.ui.view">
            <field name="name">sanad.medical.specialty.form</field>
            <field name="model">sanad.medical.specialty</field>
            <field name="arch" type="xml">
                <form string="Medical Specialty">
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="active"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_sanad_medical_specialty" model="ir.actions.act_window">
            <field name="name">Medical Specialties</field>
            <field name="res_model">sanad.medical.specialty</field>
            <field name="view_mode">list,form</field>
        </record>

    </data>
</odoo>
