<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_sanad_medical_cabinet_list" model="ir.ui.view">
            <field name="name">sanad.medical.cabinet.list</field>
            <field name="model">sanad.medical.cabinet</field>
            <field name="arch" type="xml">
                <list string="Medical Cabinets">
                    <field name="name"/>
                    <field name="phone"/>
                    <field name="email"/>
                    <field name="doctor_count"/>
                </list>
            </field>
        </record>

        <record id="view_sanad_medical_cabinet_form" model="ir.ui.view">
            <field name="name">sanad.medical.cabinet.form</field>
            <field name="model">sanad.medical.cabinet</field>
            <field name="arch" type="xml">
                <form string="Medical Cabinet">
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="%(sanad_core.action_sanad_doctor)d"
                                    type="action" class="oe_stat_button" icon="fa-user-md"
                                    context="{'default_cabinet_id': id}">
                                <field name="doctor_count" widget="statinfo" string="Doctors"/>
                            </button>
                        </div>
                        <group>
                            <field name="name"/>
                            <field name="phone"/>
                            <field name="email"/>
                            <field name="address"/>
                            <field name="active"/>
                        </group>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="action_sanad_medical_cabinet" model="ir.actions.act_window">
            <field name="name">Medical Cabinets</field>
            <field name="res_model">sanad.medical.cabinet</field>
            <field name="view_mode">list,form</field>
        </record>

    </data>
</odoo>
