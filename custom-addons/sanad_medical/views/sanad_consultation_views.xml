<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_sanad_consultation_list" model="ir.ui.view">
            <field name="name">sanad.consultation.list</field>
            <field name="model">sanad.consultation</field>
            <field name="arch" type="xml">
                <list string="Consultations">
                    <field name="date"/>
                    <field name="patient_id"/>
                    <field name="doctor_id"/>
                    <field name="reason"/>
                </list>
            </field>
        </record>

        <record id="view_sanad_consultation_form" model="ir.ui.view">
            <field name="name">sanad.consultation.form</field>
            <field name="model">sanad.consultation</field>
            <field name="arch" type="xml">
                <form string="Consultation">
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="%(action_sanad_prescription)d" type="action"
                                    class="oe_stat_button" icon="fa-medkit"
                                    context="{'default_consultation_id': id, 'default_patient_id': patient_id, 'default_doctor_id': doctor_id}">
                                <field name="prescription_count" widget="statinfo" string="Prescriptions"/>
                            </button>
                        </div>
                        <group>
                            <group>
                                <field name="patient_id" options="{'no_create': True}"/>
                                <field name="doctor_id" options="{'no_create': True}"/>
                                <field name="date"/>
                            </group>
                            <group>
                                <field name="reason"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Clinical Details">
                                <group>
                                    <field name="symptoms"/>
                                    <field name="observations"/>
                                </group>
                            </page>
                            <page string="Report">
                                <field name="report"/>
                            </page>
                            <page string="Attachments">
                                <field name="attachment_ids" widget="many2many_binary"/>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="view_sanad_consultation_search" model="ir.ui.view">
            <field name="name">sanad.consultation.search</field>
            <field name="model">sanad.consultation</field>
            <field name="arch" type="xml">
                <search string="Search Consultations">
                    <field name="patient_id"/>
                    <field name="doctor_id"/>
                    <field name="reason"/>
                    <group>
                        <filter string="Patient" name="group_patient" context="{'group_by': 'patient_id'}"/>
                        <filter string="Doctor" name="group_doctor" context="{'group_by': 'doctor_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="action_sanad_consultation" model="ir.actions.act_window">
            <field name="name">Consultations</field>
            <field name="res_model">sanad.consultation</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="view_sanad_consultation_search"/>
        </record>

    </data>
</odoo>
