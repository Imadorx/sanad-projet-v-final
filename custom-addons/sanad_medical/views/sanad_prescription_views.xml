<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_sanad_prescription_list" model="ir.ui.view">
            <field name="name">sanad.prescription.list</field>
            <field name="model">sanad.prescription</field>
            <field name="arch" type="xml">
                <list string="Prescriptions">
                    <field name="date"/>
                    <field name="patient_id"/>
                    <field name="doctor_id"/>
                    <field name="medication"/>
                    <field name="dosage"/>
                    <field name="pharmacy_status" decoration-success="pharmacy_status == 'completed'" decoration-info="pharmacy_status == 'pending'"/>
                </list>
            </field>
        </record>

        <record id="view_sanad_prescription_form" model="ir.ui.view">
            <field name="name">sanad.prescription.form</field>
            <field name="model">sanad.prescription</field>
            <field name="arch" type="xml">
                <form string="Prescription">
                    <header>
                        <field name="pharmacy_status" widget="statusbar"
                               statusbar_visible="pending,received,prepared,completed"/>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="patient_id" options="{'no_create': True}"/>
                                <field name="doctor_id" options="{'no_create': True}"/>
                                <field name="consultation_id" options="{'no_create': True}"/>
                                <field name="date"/>
                            </group>
                            <group>
                                <field name="medication"/>
                                <field name="dosage"/>
                                <field name="frequency"/>
                                <field name="duration"/>
                                <field name="pharmacy_id" options="{'no_create': True}"/>
                            </group>
                        </group>
                        <group string="Instructions">
                            <field name="instructions" nolabel="1"/>
                        </group>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="view_sanad_prescription_search" model="ir.ui.view">
            <field name="name">sanad.prescription.search</field>
            <field name="model">sanad.prescription</field>
            <field name="arch" type="xml">
                <search string="Search Prescriptions">
                    <field name="patient_id"/>
                    <field name="doctor_id"/>
                    <field name="medication"/>
                    <filter string="Pending" name="pending" domain="[('pharmacy_status','=','pending')]"/>
                    <group>
                        <filter string="Patient" name="group_patient" context="{'group_by': 'patient_id'}"/>
                        <filter string="Status" name="group_status" context="{'group_by': 'pharmacy_status'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="action_sanad_prescription" model="ir.actions.act_window">
            <field name="name">Prescriptions</field>
            <field name="res_model">sanad.prescription</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="view_sanad_prescription_search"/>
        </record>

    </data>
</odoo>
