<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_sanad_medical_record_form" model="ir.ui.view">
            <field name="name">sanad.medical.record.form</field>
            <field name="model">sanad.medical.record</field>
            <field name="arch" type="xml">
                <form string="Medical Record">
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="%(action_sanad_consultation)d" type="action"
                                    class="oe_stat_button" icon="fa-stethoscope"
                                    context="{'default_patient_id': patient_id, 'search_default_patient_id': patient_id}">
                                <field name="consultation_count" widget="statinfo" string="Consultations"/>
                            </button>
                            <button name="%(action_sanad_prescription)d" type="action"
                                    class="oe_stat_button" icon="fa-medkit"
                                    context="{'default_patient_id': patient_id, 'search_default_patient_id': patient_id}">
                                <field name="prescription_count" widget="statinfo" string="Prescriptions"/>
                            </button>
                        </div>
                        <group>
                            <field name="patient_id" options="{'no_create': True}"/>
                            <field name="last_consultation_date" readonly="1"/>
                        </group>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="view_sanad_medical_record_list" model="ir.ui.view">
            <field name="name">sanad.medical.record.list</field>
            <field name="model">sanad.medical.record</field>
            <field name="arch" type="xml">
                <list string="Medical Records">
                    <field name="patient_id"/>
                    <field name="consultation_count"/>
                    <field name="prescription_count"/>
                    <field name="last_consultation_date"/>
                </list>
            </field>
        </record>

        <record id="action_sanad_medical_record" model="ir.actions.act_window">
            <field name="name">Medical Records</field>
            <field name="res_model">sanad.medical.record</field>
            <field name="view_mode">list,form</field>
        </record>

    </data>
</odoo>
