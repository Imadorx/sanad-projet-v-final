<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_sanad_lab_result_list" model="ir.ui.view">
            <field name="name">sanad.lab.result.list</field>
            <field name="model">sanad.lab.result</field>
            <field name="arch" type="xml">
                <list string="Laboratory Results" decoration-danger="is_out_of_range == True">
                    <field name="date"/>
                    <field name="patient_id"/>
                    <field name="analysis_name"/>
                    <field name="result_value"/>
                    <field name="unit"/>
                    <field name="reference_range"/>
                    <field name="is_out_of_range"/>
                </list>
            </field>
        </record>

        <record id="view_sanad_lab_result_form" model="ir.ui.view">
            <field name="name">sanad.lab.result.form</field>
            <field name="model">sanad.lab.result</field>
            <field name="arch" type="xml">
                <form string="Laboratory Result">
                    <sheet>
                        <group>
                            <group>
                                <field name="request_id" options="{'no_create': True}"/>
                                <field name="patient_id" readonly="1"/>
                                <field name="date"/>
                            </group>
                            <group>
                                <field name="analysis_name"/>
                                <field name="result_value"/>
                                <field name="unit"/>
                                <field name="reference_range"/>
                                <field name="is_out_of_range" readonly="1"/>
                            </group>
                        </group>
                        <group string="Document">
                            <field name="document" filename="document_filename"/>
                            <field name="document_filename" invisible="1"/>
                        </group>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="action_sanad_lab_result" model="ir.actions.act_window">
            <field name="name">Laboratory Results</field>
            <field name="res_model">sanad.lab.result</field>
            <field name="view_mode">list,form</field>
        </record>

    </data>
</odoo>
