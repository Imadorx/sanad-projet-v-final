<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Every non-admin role sees ONLY conversations they participate
             in. This is the single rule that matters for chat privacy -
             everything else (pairing rules, care-relationship checks) is
             enforced at creation time in Python. -->
        <record id="rule_sanad_chat_conversation_participant" model="ir.rule">
            <field name="name">Conversation: participants only</field>
            <field name="model_id" ref="model_sanad_chat_conversation"/>
            <field name="domain_force">[('participant_ids', 'in', [user.id])]</field>
            <field name="groups" eval="[(4, ref('sanad_core.group_sanad_doctor')),
                                        (4, ref('sanad_core.group_sanad_patient')),
                                        (4, ref('sanad_core.group_sanad_laboratory')),
                                        (4, ref('sanad_core.group_sanad_pharmacy'))]"/>
        </record>

        <record id="rule_sanad_chat_conversation_admin" model="ir.rule">
            <field name="name">Conversation: admin full access</field>
            <field name="model_id" ref="model_sanad_chat_conversation"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('sanad_core.group_sanad_admin'))]"/>
        </record>

    </data>
</odoo>
