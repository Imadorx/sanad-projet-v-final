# SANAD Healthcare Platform - environment template
# Copy to .env and fill in real values before running docker compose.

# --- PostgreSQL ---
POSTGRES_USER=odoo
POSTGRES_PASSWORD=odoo

# --- Odoo ---
# NOTE: the Odoo master/admin password is NOT read from this file.
# It must be set directly in docker/odoo.conf (admin_passwd=...) before
# any shared or production use - the stock odoo:19 Docker image has no
# environment-variable mechanism for it. See docker/odoo.conf comments.

# --- Frontend (only needed for local `npm run dev`, not for Docker) ---
VITE_ODOO_URL=http://localhost:8069

# --- SANAD AI provider (optional - defaults to safe offline mock) ---
# These are also settable via Odoo Settings > General Settings > SANAD AI
# after install; env vars here are for reference/documentation only,
# since sanad_ai reads them from ir.config_parameter, not the OS environment.
# SANAD_AI_PROVIDER=anthropic
# SANAD_AI_API_KEY=sk-ant-...
# SANAD_AI_MODEL=claude-sonnet-4-6
